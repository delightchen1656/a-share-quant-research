量化审查/**/*.py

# Editors and operating systems
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Current locked baselines must remain reproducible from a fresh clone.
!strategies/kechuang/backtest/data/
!strategies/kechuang/backtest/data/**
!strategies/hushen/backtest/data/
!strategies/hushen/backtest/data/**
!strategies/kechuang/results/**/*.parquet
!strategies/hushen/results/**/*.parquet
!strategies/hushen_2/results/EQUITY_CURVES_2020Q1_STARTS_TO_20261019.parquet
!strategies/kechuang/research/training_source/model_artifacts/*.joblib

# Holdout/posterior evidence remains local and is never part of the public
# pre-2025 repository context.
**/holdout_restricted/**

# Historical model binaries are small and part of the research record.
!archive/**/models/
!archive/**/models/*.joblib
!archive/**/*.joblib

# The portable migration bundle is a local/offline deliverable. Git stores its
# manifests and recovery scripts, while the large ZIPs and installers stay out.
/archive/packages/20261006_data_environment_bundle/*.zip
/archive/packages/20261006_data_environment_bundle/installers/*.exe
