{
  "schema_version": 1,
  "frozen_before_results": true,
  "boundary_version": "public-pre2025-v1",
  "data_cutoff": "2024-12-31",
  "warmup_start": "2013-01-01",
  "development_years": [2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023],
  "confirmation_year": 2024,
  "benchmark": "SSE Composite price index",
  "initial_cash_cny": 100000,
  "start_rule": "every trading session in Q1 of each evaluation year; end is that calendar year's final trading session",
  "signal_lag": "all features and ranks use the prior completed trading session",
  "eligibility": {
    "listed_observations_min": 252,
    "amount_20d_min_cny": 10000000,
    "close_min_cny": 2,
    "not_st": true,
    "not_paused": true,
    "volatility_60d_min": 0.001,
    "volatility_60d_max": 0.09
  },
  "factor_definitions": {
    "cap": "close * volume / (turn / 100); cross-sectional percentile rank; smaller preferred by negative weight",
    "vol60": "std(close / preclose - 1, 60 sessions), paused return set to zero; cross-sectional percentile rank",
    "overnight20": "sum(log(open / preclose), 20 sessions); cross-sectional percentile rank",
    "intraday20": "sum(log(close / open), 20 sessions); cross-sectional percentile rank",
    "mom60": "sum(log(close / preclose), 60 sessions); cross-sectional percentile rank",
    "reversal5": "sum(log(close / preclose), 5 sessions); cross-sectional percentile rank; reversal uses negative weight",
    "turn20": "mean(turn, 20 sessions); cross-sectional percentile rank"
  },
