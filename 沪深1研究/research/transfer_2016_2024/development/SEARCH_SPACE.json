  "stage_a_execution": {"count":5,"interval":20,"buffer":1.5,"exposure":0.98,"participation":0.005,"drift":false},
  "stage_b_rule": "take the top three Stage-A signals by the frozen objective tuple, including B0 if it is not already among them; cross each with the listed execution variants",
  "stage_b_execution_grid": {
    "count": [5, 8],
    "interval": [15, 20, 30],
    "buffer": [1.5, 2.0]
